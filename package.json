{
  "name": "carnet-pro",
  "private": true,
  "devDependencies": {
    "knip": "6.41.0",
    "npm-check-updates": "^18.3.1",
    "turbo": "^2.10.4"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "turbo run build",
    "check": "bun run docs:check && bun run docs:check:test && bun run lint && bun run knip && bun run typecheck && bun run --filter web check:architecture && bun run test && bun run build && bun run --filter web check:performance",
    "dev": "turbo run dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@repo/database",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "persons:performance": "bun run --filter @repo/database db:persons:performance-check",
    "maintenance": "bun run --filter web maintenance",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=web",
    "test:postgres": "bun run --filter web test:postgres",
    "typecheck": "turbo run typecheck",
    "clear": "bun scripts/clear-workspace.mjs",
    "docs:check": "bun scripts/check-docs.mjs",
    "knip": "knip --no-progress",
    "docs:check:test": "node --test scripts/check-docs.test.mjs",
    "ncu": "ncu -ws -i"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@humanfs/node": "0.16.8",
    "brace-expansion": "1.1.21",
    "deepmerge-ts": "8.0.2",
    "flatted": "3.4.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "rollup": "4.62.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite": "7.3.7"
  }
}
